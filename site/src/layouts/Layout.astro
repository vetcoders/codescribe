---
// Self-hosted fonts (WEBSITE_SPEC §2). Per-weight CSS includes the latin-ext
// subset via unicode-range — required for the verbatim Polish copy in the
// Formatting section (ą/ę/ł/ż…). font-display: swap is the @fontsource default.
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/600.css';
import '../styles/global.css';

// Preload the above-the-fold fonts so the first paint uses the real web font
// instead of a fallback that swaps in later (font-swap text reflow was the sole
// source of hero CLS). Vite resolves `?url` to the hashed, emitted asset path.
import sg700 from '@fontsource/space-grotesk/files/space-grotesk-latin-700-normal.woff2?url';
import sg600 from '@fontsource/space-grotesk/files/space-grotesk-latin-600-normal.woff2?url';
import sg500 from '@fontsource/space-grotesk/files/space-grotesk-latin-500-normal.woff2?url';
import sg400 from '@fontsource/space-grotesk/files/space-grotesk-latin-400-normal.woff2?url';
import jb500 from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-500-normal.woff2?url';
const preloadFonts = [sg700, sg600, sg500, sg400, jb500];

interface Props {
  title?: string;
  description?: string;
  /** Optional path under base for canonical (e.g. "privacy" → /codescribe/privacy/). */
  path?: string;
}

const {
  title = 'codescribe — a macOS voice control layer for text, code & AI agents',
  description = 'codescribe is a macOS-native voice control layer for text, code and AI agents. Not voice typing — voice to intent to action. Dictate, format, ask, remember, and dispatch work from one always-available overlay.',
  path,
} = Astro.props;

// Absolute URLs for canonical / social cards. SITE = https://vetcoders.github.io,
// base → canonical https://vetcoders.github.io/codescribe/
const site = import.meta.env.SITE ?? 'https://vetcoders.github.io';
// astro.config sets `base: "/codescribe"` with NO trailing slash, so BASE_URL is
// "/codescribe" — not "/codescribe/". The slash is load-bearing here: `new URL`
// treats a slashless base as a FILE and replaces it, so resolving "privacy/"
// against it yields https://vetcoders.github.io/privacy/ — a 404 advertised as
// this page's canonical. Normalise to a directory before resolving anything.
const base = import.meta.env.BASE_URL;
const baseDir = base.endsWith('/') ? base : `${base}/`;
const baseUrl = new URL(baseDir, site);
const pathClean = path ? path.replace(/^\//, '').replace(/\/$/, '') + '/' : '';
const canonical = pathClean ? new URL(pathClean, baseUrl).href : baseUrl.href;
const ogImage = new URL(base.replace(/\/$/, '') + '/og.png', site).href;
// B3 has not been approved: no default domain means no analytics request in any
// normal build. A consented deployment opts in explicitly at build time.
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN?.trim();
const plausibleScriptSrc =
  import.meta.env.PUBLIC_PLAUSIBLE_SCRIPT_SRC?.trim() || 'https://plausible.io/js/script.js';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {preloadFonts.map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}
    <meta name="theme-color" content="#090a0d" />
    <link rel="icon" type="image/png" href={base.replace(/\/$/, '') + '/icon.png'} />
    {plausibleDomain && (
      <script is:inline defer data-domain={plausibleDomain} src={plausibleScriptSrc}></script>
    )}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="codescribe" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
