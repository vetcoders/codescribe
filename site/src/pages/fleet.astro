---
// Fleet demo page: the voice→agents loop, recorded live on 2026-10-03.
// Wording stays Vibecrafted-safe (brand rules §1): the bridge speaks to agent
// runtimes; Claude Code / Codex appear as what the recorded demo actually ran,
// not as hard integrations. Diagrams are hand-built in the site's own idiom
// (no diagram libraries — README: plain CSS, two tiny islands total).
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { page } from '../lib/asset';
---

<Layout
  title="codescribe — talk to your fleet"
  description="One spoken sentence reaches live agent sessions on two machines — different vendors, spoken replies, and a receipt for every delivery. Recorded live, October 2026."
  path="fleet"
>
  <Nav current="fleet" />
  <main id="main">
    <!-- ============ HERO ============ -->
    <section class="section hero" aria-labelledby="fleet-title">
      <div class="container">
        <p class="eyebrow">VOICE → FLEET · RECORDED LIVE · 2026-10-03</p>
        <h1 id="fleet-title">Talk to your fleet.</h1>
        <p class="sub">
          Every chat window speaks to one model. codescribe speaks to a fleet:
          one spoken sentence reaches live agent sessions on two machines,
          different vendors answer out loud, and every delivery leaves a receipt.
        </p>
        <div class="wavebar" aria-hidden="true">
          {Array.from({ length: 48 }).map((_, i) => (
            <span style={`--d:${(i * 0.09) % 1.7}s;--h:${8 + Math.round(Math.abs(Math.sin(i * 0.55)) * 30)}px`}></span>
          ))}
        </div>
        <div class="stats">
          <div class="stat"><strong>241&nbsp;ms</strong><span>seal → agent queue</span></div>
          <div class="stat"><strong>2</strong><span>machines, one bus</span></div>
          <div class="stat"><strong>3</strong><span>agent runtimes answering</span></div>
          <div class="stat"><strong>100%</strong><span>deliveries acknowledged</span></div>
        </div>
      </div>
    </section>

    <!-- ============ LIVE LOOP ============ -->
    <section class="section loop" aria-labelledby="loop-title">
      <div class="container">
        <p class="eyebrow">NOT A MOCKUP</p>
        <h2 id="loop-title">A real afternoon, on the record.</h2>
        <p class="sub">
          These are envelopes from the session that built this page. The founder
          spoke; a Claude Code session woke up, answered in its own voice, and
          acknowledged the delivery — then was told, by voice, to build this page.
        </p>

        <div class="tape" role="group" aria-label="Recorded envelope">
          <div class="tape__head">seal · channel 1 · audience klaudiusz</div>
          <pre><code>{`{ "kind": "seal", "delivery_id": "05f956af…",
  "status": "transcript_sealed",
  "text": "…czas do otrzymania wiadomości —
           jest zajebiste." }`}</code></pre>
          <div class="tape__caption">Spoken in Polish, verbatim: “…the delivery time — it’s superb.”</div>
        </div>

        <div class="reply">
          <span class="reply__who">claude session · voice “cedar” · spoken: true</span>
          “I hear you on channel one — the envelope woke me right after my turn ended.”
        </div>

        <div class="tape">
          <div class="tape__head">four turns later</div>
          <pre><code>{`{ "kind": "seal", "delivery_id": "c82f5d03…",
  "text": "…this belongs on the codescribe site." }`}</code></pre>
          <div class="tape__caption">The page you are reading is that delivery, acknowledged.</div>
        </div>
      </div>
    </section>

    <!-- ============ CIRCUIT ============ -->
    <section class="section circuit" aria-labelledby="circuit-title">
      <div class="container">
        <p class="eyebrow">ONE CIRCUIT</p>
        <h2 id="circuit-title">Seal → envelope → wake → reply → receipt.</h2>
        <ol class="steps">
          <li><span class="n">01</span><p><strong>Seal.</strong> Your words become a transcript sealed in the
            acoustic ledger — identity is the audio span itself, not a guess.</p></li>
          <li><span class="n">02</span><p><strong>Envelope.</strong> The bus demultiplexer wraps the seal for its
            audience: a channel, a lease, a <code>delivery_id</code>.</p></li>
          <li><span class="n">03</span><p><strong>Wake.</strong> Each runtime has its native edge — a queue that
            wakes a Codex session, a task that wakes a Claude Code session after its turn.</p></li>
          <li><span class="n">04</span><p><strong>Reply.</strong> The agent answers on the same bus — and out loud,
            in its own assigned voice.</p></li>
          <li><span class="n">05</span><p><strong>Receipt.</strong> The agent acknowledges the
            <code>delivery_id</code>. Unacknowledged mail stays pending; nothing is lost silently.</p></li>
        </ol>
      </div>
    </section>

    <!-- ============ TOPOLOGY ============ -->
    <section class="section topo" aria-labelledby="topo-title">
      <div class="container">
        <p class="eyebrow">TOPOLOGY</p>
        <h2 id="topo-title">One bus, many edges.</h2>
        <div class="flow" aria-hidden="true">
          <div class="node"><div class="circle c-voice"><span class="bead b-terra"></span></div><div class="node__label">Voice</div></div>
          <div class="connector"></div>
          <div class="node"><div class="circle c-seal"><span class="bead b-sq b-terra2"></span></div><div class="node__label">Seal + ledger</div></div>
          <div class="connector"></div>
          <div class="node"><div class="circle c-bus"><span class="bead b-sq b-gold"></span></div><div class="node__label">Bus</div></div>
          <div class="connector"></div>
          <div class="node"><div class="circle c-demux"><span class="bead b-olive"></span></div><div class="node__label">Demux</div></div>
          <div class="connector"></div>
          <div class="fanout">
            <div class="agentrow"><span class="dot"></span>Claude Code · machine A · “cedar”</div>
            <div class="agentrow"><span class="dot"></span>Codex · machine B · “Eve”</div>
            <div class="agentrow"><span class="dot"></span>Kimi · machine A · “rex”</div>
          </div>
        </div>
        <p class="note">
          In the recorded demo the edges were live Claude Code and Codex CLI
          sessions on two Macs. The bridge speaks to agent runtimes through
          their own mechanisms — no vendor integration required on the model’s side.
        </p>
      </div>
    </section>

    <!-- ============ DISCIPLINE ============ -->
    <section class="section disc" aria-labelledby="disc-title">
      <div class="container">
        <p class="eyebrow">DELIVERY DISCIPLINE</p>
        <h2 id="disc-title">A channel has a lifecycle, not a vibe.</h2>
        <p class="sub">
          Channel ownership is identity in a locked binding; a heartbeat lease
          only says whether anyone is listening. A crashed listener can’t hand
          your channel to a stranger — taking over a dead session is a deliberate
          operator ritual.
        </p>
        <div class="states" aria-label="Channel lifecycle">
          <span class="state">free</span><span class="arrow">→</span>
          <span class="state">bound</span><span class="arrow">→</span>
          <span class="state state--on">listening</span><span class="arrow">→</span>
          <span class="state">pending</span><span class="arrow">→</span>
          <span class="state state--ack">acknowledged</span>
        </div>
        <div class="states states--ghost" aria-label="Takeover path">
          <span class="state state--ghost">ghost (session died)</span><span class="arrow">→</span>
          <span class="state">operator takeover</span><span class="arrow">→</span>
          <span class="state">bound again</span>
        </div>
      </div>
    </section>

    <!-- ============ LEDGER ============ -->
    <section class="section ledger" aria-labelledby="ledger-title">
      <div class="container">
        <p class="eyebrow">UNDERNEATH: THE ACOUSTIC LEDGER</p>
        <h2 id="ledger-title">Who may touch a word.</h2>
        <p class="sub">
          Every word belongs to a span of audio, and every producer has a rank.
          Nothing overwrites silently — a change needs a receipt. The human
          outranks everyone, always.
        </p>
        <div class="ranks" aria-label="Producer ranks, ascending">
          <span class="rank">Apple <i>0</i></span>
          <span class="rank">CloudLive <i>1</i></span>
          <span class="rank">Whisper <i>2</i></span>
          <span class="rank">Lexicon <i>3</i></span>
          <span class="rank">Formatter <i>4</i></span>
          <span class="rank rank--human">Human <i>5</i></span>
        </div>
      </div>
    </section>

    <!-- ============ CTA ============ -->
    <section class="section cta" aria-labelledby="cta-title">
      <div class="container">
        <h2 id="cta-title">One bus. N agents. Your voice.</h2>
        <a class="button" href={`${page('')}#install`}>Install codescribe</a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  /* hero */
  .hero { padding: 130px 24px 90px; text-align: center;
    background: radial-gradient(60% 90% at 50% 0%, rgba(217, 119, 87, 0.07), transparent 60%); }
  h1 { font: 700 clamp(40px, 7vw, 72px) / 1.02 var(--font-display);
    letter-spacing: -0.035em; color: var(--ink); margin: 14px 0 10px; }
  h2 { font: 700 clamp(28px, 4.6vw, 44px) / 1.08 var(--font-display);
    letter-spacing: -0.03em; color: var(--ink); margin: 14px 0 8px; }
  .sub { font: 400 16px / 1.6 var(--font-display); color: var(--muted-2);
    max-width: 560px; margin: 0 auto 8px; }
  .container { max-width: 1000px; margin: 0 auto; text-align: center; }

  .wavebar { display: flex; align-items: center; justify-content: center;
    gap: 3px; height: 54px; margin: 34px auto 26px; max-width: 420px; }
  .wavebar span { width: 4px; height: var(--h, 14px); border-radius: 2px;
    background: var(--terracotta); opacity: 0.5;
    animation: breathe 1.7s ease-in-out infinite; animation-delay: var(--d, 0s); }

  .stats { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 18px; }
  .stat { min-width: 150px; padding: 14px 18px; background: var(--bg-card);
    border: 1px solid var(--stroke); border-radius: var(--radius-card); }
  .stat strong { display: block; font: 700 26px var(--font-display); color: var(--ink);
    font-variant-numeric: tabular-nums; }
  .stat span { font: 500 11px var(--font-mono); color: var(--muted-2); }

  /* sections rhythm */
  .section { padding: 96px 24px; }
  .section + .section { border-top: 1px solid var(--hairline); }

  /* tapes (envelopes) */
  .loop .container { max-width: 760px; }
  .tape { text-align: left; background: var(--bg-soft); border: 1px solid var(--stroke);
    border-radius: var(--radius-card); margin: 26px 0 0; overflow: hidden; }
  .tape__head { font: 600 11px var(--font-mono); color: var(--eyebrow);
    letter-spacing: 0.08em; text-transform: uppercase;
    padding: 9px 16px; border-bottom: 1px solid var(--hairline); }
  .tape pre { margin: 0; padding: 14px 16px; overflow-x: auto; }
  .tape code { font: 500 12.5px / 1.6 var(--font-mono); color: var(--ink-2); }
  .tape__caption { font: 400 12px var(--font-display); color: var(--muted-2);
    padding: 9px 16px; border-top: 1px solid var(--hairline); }
  .reply { text-align: left; margin: 18px 0 0; padding: 12px 0 12px 18px;
    border-left: 3px solid var(--terracotta); font: 400 15px / 1.55 var(--font-display);
    color: var(--ink-2); font-style: italic; }
  .reply__who { display: block; font: 500 11px var(--font-mono); color: var(--muted-2);
    font-style: normal; margin-bottom: 4px; }

  /* circuit steps */
  .circuit .container { max-width: 720px; }
  .steps { list-style: none; margin: 34px 0 0; padding: 0; text-align: left;
    display: grid; gap: 14px; }
  .steps li { display: grid; grid-template-columns: 44px minmax(0, 1fr); gap: 14px;
    padding: 16px 18px; background: var(--bg-card); border: 1px solid var(--stroke);
    border-radius: var(--radius-card); font: 400 14.5px / 1.6 var(--font-display);
    color: var(--muted); min-width: 0; }
  .steps li p { margin: 0; min-width: 0; overflow-wrap: anywhere; }
  .steps li strong { color: var(--ink); }
  .steps .n { font: 600 13px var(--font-mono); color: var(--terracotta); padding-top: 3px; }
  .steps code { font: 500 0.85em var(--font-mono); color: var(--terracotta-ink); }

  /* topology */
  .flow { display: flex; align-items: center; justify-content: center;
    flex-wrap: wrap; gap: 6px; margin: 44px 0 10px; }
  .node { display: flex; flex-direction: column; align-items: center; gap: 10px; width: 120px; }
  .circle { width: 56px; height: 56px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center; }
  .c-voice { background: rgba(217, 119, 87, 0.1); border: 1px solid #3a2c25;
    animation: glowpulse 3s ease-in-out infinite; }
  .c-seal { background: rgba(255, 255, 255, 0.03); border: 1px solid var(--stroke-3); }
  .c-bus { background: rgba(214, 178, 78, 0.08); border: 1px solid #3a3425; }
  .c-demux { background: rgba(95, 107, 62, 0.1); border: 1px solid #2f3a26; }
  .bead { width: 13px; height: 13px; border-radius: 50%; }
  .b-sq { border-radius: 3px; }
  .b-terra { background: var(--terracotta); }
  .b-terra2 { background: var(--terracotta-2); }
  .b-gold { background: var(--gold); }
  .b-olive { background: var(--olive-ink); }
  .node__label { font: 600 12px var(--font-display); color: var(--ink-2); }
  .connector { flex: 0 0 34px; height: 1px; margin-bottom: 28px;
    background: linear-gradient(90deg, #2a2d33, #3a3d44, #2a2d33); }
  .fanout { display: grid; gap: 8px; text-align: left; }
  .agentrow { display: flex; align-items: center; gap: 9px;
    padding: 9px 14px; background: var(--bg-chip); border: 1px solid var(--stroke);
    border-radius: 9px; font: 500 12px var(--font-mono); color: #b6b9b2; }
  .agentrow .dot { width: 7px; height: 7px; border-radius: 50%;
    background: var(--olive-ink); animation: softpulse 2.4s ease-in-out infinite; }
  .note { font: 400 13px / 1.6 var(--font-display); color: var(--muted-2);
    max-width: 560px; margin: 22px auto 0; }

  /* discipline */
  .states { display: flex; flex-wrap: wrap; align-items: center; justify-content: center;
    gap: 8px; margin-top: 26px; }
  .states--ghost { margin-top: 12px; }
  .state { padding: 7px 13px; background: var(--bg-chip); border: 1px solid var(--stroke);
    border-radius: 999px; font: 500 12px var(--font-mono); color: #b6b9b2; }
  .state--on { border-color: #2f3a26; color: var(--olive-ink);
    background: rgba(95, 107, 62, 0.1); }
  .state--ack { border-color: #3a3425; color: var(--gold);
    background: rgba(214, 178, 78, 0.07); }
  .state--ghost { border-color: #3a2c25; color: var(--terracotta-ink);
    background: rgba(217, 119, 87, 0.07); }
  .arrow { color: var(--muted-3); font: 500 12px var(--font-mono); }

  /* ledger ranks */
  .ranks { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: center;
    gap: 9px; margin-top: 30px; }
  .rank { padding: 9px 14px; background: var(--bg-chip); border: 1px solid var(--stroke);
    border-radius: 9px; font: 600 12.5px var(--font-display); color: var(--ink-2); }
  .rank i { font: 500 11px var(--font-mono); color: var(--muted-2); font-style: normal;
    margin-left: 6px; }
  .rank--human { border-color: #3a2c25; background: rgba(217, 119, 87, 0.1);
    color: var(--terracotta-ink); padding: 12px 18px; }

  /* cta */
  .cta { padding-bottom: 130px; }
  .button { display: inline-block; margin-top: 22px; padding: 13px 26px;
    background: var(--terracotta); color: #0a0a0a; border-radius: 10px;
    font: 600 14px var(--font-display); text-decoration: none; }
  .button:hover { background: var(--terracotta-2); }

  @media (max-width: 640px) {
    .section { padding: 72px 20px; }
    .hero { padding: 96px 20px 64px; }
    .connector { flex-basis: 18px; }
    .steps li { grid-template-columns: 34px minmax(0, 1fr); }
  }
</style>
