---
import { page } from '../lib/asset';
const guideUrl = page('guide');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting to Codescribe Guide & Agent Channels...</title>
    <meta http-equiv="refresh" content={`0;url=${guideUrl}`} />
    <link rel="canonical" href="https://codescribe.vetcoders.io/guide/" />
    <script is:inline define:vars={{ guideUrl }}>
      window.location.replace(guideUrl);
    </script>
  </head>
  <body style="background: #090a0d; color: #f4f2ec; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; padding: 60px 20px; text-align: center;">
    <p style="font-size: 16px; color: #9a9d97;">
      Redirecting to <a href={guideUrl} style="color: #d97757; text-decoration: underline;">Codescribe Guide & Agent Channels</a>...
    </p>
  </body>
</html>
