---
import Layout from "../layouts/Layout.astro";
import LegalPage from "../components/LegalPage.astro";
import { page } from "../lib/asset";
---

<Layout
  title="Support — codescribe"
  description="Get help with codescribe: email hello@vetcoders.io, GitHub Issues, and honest response times."
  path="support"
>
  <LegalPage title="Support" eyebrow="Trust · Support" updated="2026-10-14">
    <p>
      Codescribe is a local-first macOS app from Vetcoders / LibraxisAI. We keep
      support human and small-team honest.
    </p>

    <h2>Contact</h2>
    <table>
      <thead>
        <tr>
          <th>Channel</th>
          <th>Use for</th>
          <th>Expected response</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>
            <strong>Email</strong><br />
            <a href="mailto:hello@vetcoders.io">hello@vetcoders.io</a>
          </td>
          <td>License keys, private bugs, accessibility</td>
          <td
            ><strong>Within 2 business days</strong> (Mon–Fri, Europe/Warsaw)</td
          >
        </tr>
        <tr>
          <td>
            <strong>GitHub Issues</strong><br />
            <a
              href="https://github.com/vetcoders/codescribe/issues"
              target="_blank"
              rel="noopener noreferrer"
              >github.com/vetcoders/codescribe/issues</a
            >
          </td>
          <td>Public bugs, feature requests, reproducible crashes</td>
          <td>Best-effort triage; often same 2 business days when active</td>
        </tr>
        <tr>
          <td>
            <strong>Docs</strong><br />
            <a href={page("guide")}>User guide</a>
            · <a
              href="https://github.com/vetcoders/codescribe#readme"
              target="_blank"
              rel="noopener noreferrer">README</a
            >
          </td>
          <td>Setup, hotkeys, agent channels; source builds in the README</td>
          <td>Self-serve, always available</td>
        </tr>
      </tbody>
    </table>

    <h2>What to include</h2>
    <p>For faster help, send:</p>
    <ul>
      <li>App version (Tray → About, or Settings → User)</li>
      <li>macOS version and Apple Silicon machine class</li>
      <li>What you expected vs what happened</li>
      <li>Whether the issue is offline Raw mode or an AI/agent path</li>
      <li>For license keys: the email you used on the license form (never paste API keys)</li>
    </ul>

    <h2>Security reports</h2>
    <p>
      Please email <a href="mailto:security@vetcoders.io">security@vetcoders.io</a>
      (fallback <a href="mailto:hello@vetcoders.io">hello@vetcoders.io</a>) rather
      than opening a public issue for vulnerabilities that could put users at risk.
      See the
      <a
        href="https://github.com/vetcoders/codescribe/blob/main/SECURITY.md"
        target="_blank"
        rel="noopener noreferrer">security policy</a
      > for what to include and response targets.
    </p>

    <h2>Policies</h2>
    <p>
      <a href={page("privacy")}>Privacy Policy</a>
      · <a href={page("terms")}>Terms of Use &amp; EULA</a>
      · <a href={page("refunds")}>Refund Policy</a>
    </p>
  </LegalPage>
</Layout>
