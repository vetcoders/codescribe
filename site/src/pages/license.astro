---
import Layout from '../layouts/Layout.astro';
import LegalPage from '../components/LegalPage.astro';
import { page } from '../lib/asset';
const isPagesCopy = import.meta.env.BASE_URL.startsWith('/codescribe');
---

<Layout
  title="Get a license key — codescribe"
  description="Get your Codescribe license key and activate it in Settings → License."
  path="license"
>
  <LegalPage title="Get a license key" eyebrow="Open beta" updated="2026-10-06">
    <p>
      Codescribe is in open beta. Enter your email to get a license key,
      then paste it into <strong>Settings → License</strong> in the
      app. Your email is sent over HTTPS to our license service. The signed key
      contains its SHA-256 hash rather than the address. The service records
      that hash, your IP address, and the issue time; see the
      <a href={page("privacy")}>Privacy Policy</a>.
    </p>

    {isPagesCopy && <p>License issuance is hosted on the main website.
      <a href="https://codescribe.vetcoders.io/license/">Open the license form</a>.</p>}
    <div hidden={isPagesCopy}>
    <form id="licence-form" autocomplete="email">
      <label for="licence-email">Email</label>
      <div class="licence-row">
        <input
          id="licence-email"
          name="email"
          type="email"
          required
          placeholder="you@example.com"
          inputmode="email"
        />
        <button type="submit" id="licence-submit">Get license key</button>
      </div>
    </form>

    <div id="licence-result" hidden>
      <h2>License key</h2>
      <pre id="licence-code" tabindex="0"></pre>
      <p>
        <button type="button" id="licence-copy">Copy key</button>
        <span id="licence-meta"></span>
      </p>
      <p>
        Paste the key into <strong>Settings → License</strong> in Codescribe.
      </p>
    </div>

    <p id="licence-error" role="alert" hidden></p>
    </div>

  </LegalPage>
</Layout>

<style>
  .licence-row {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .licence-row input {
    flex: 1 1 260px;
    padding: 0.55rem 0.75rem;
    font: inherit;
  }
  #licence-code {
    white-space: pre-wrap;
    word-break: break-all;
    user-select: all;
  }
</style>

<script>
  const form = document.getElementById('licence-form') as HTMLFormElement;
  const emailInput = document.getElementById('licence-email') as HTMLInputElement;
  const submit = document.getElementById('licence-submit') as HTMLButtonElement;
  const result = document.getElementById('licence-result') as HTMLElement;
  const codeEl = document.getElementById('licence-code') as HTMLElement;
  const metaEl = document.getElementById('licence-meta') as HTMLElement;
  const errorEl = document.getElementById('licence-error') as HTMLElement;
  const copyBtn = document.getElementById('licence-copy') as HTMLButtonElement;

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorEl.hidden = true;
    result.hidden = true;
    submit.disabled = true;
    submit.textContent = 'Generating…';
    try {
      // Same origin — the issuer runs behind /api on this host.
      const response = await fetch('/api/license/issue', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ email: emailInput.value }),
      });
      const body = await response.json();
      if (!response.ok) throw new Error(body.error ?? `HTTP ${response.status}`);
      codeEl.textContent = body.license;
      metaEl.textContent = `Updates through ${body.updates_until} · Device limit: ${body.seat_limit}`;
      result.hidden = false;
    } catch (error) {
      errorEl.textContent =
        error instanceof Error ? error.message : 'License service is unreachable — try again in a minute.';
      errorEl.hidden = false;
    } finally {
      submit.disabled = false;
      submit.textContent = 'Get license key';
    }
  });

  copyBtn.addEventListener('click', async () => {
    await navigator.clipboard.writeText(codeEl.textContent ?? '');
    copyBtn.textContent = 'Copied';
    setTimeout(() => (copyBtn.textContent = 'Copy key'), 1500);
  });
</script>
