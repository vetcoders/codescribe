---
import Layout from '../layouts/Layout.astro';
import LegalPage from '../components/LegalPage.astro';
import { page } from '../lib/asset';
---

<Layout
  title="Refund Policy — codescribe"
  description="Codescribe is free during the open beta. Nothing is sold, so there is nothing to refund."
  path="refunds"
>
  <LegalPage title="Refund Policy" eyebrow="Trust · Refunds" updated="2026-10-14">
    <p>
      Codescribe is not sold today. The app download and the
      <a href={page('license')}>open-beta license key</a> are free, and the
      website has no checkout. No payment is taken, so there is nothing to
      refund.
    </p>
    <p>
      If that changes, this page will describe the refund terms that apply to
      the paid offer.
    </p>

    <h2>Questions</h2>
    <p>
      Email <a href="mailto:hello@vetcoders.io">hello@vetcoders.io</a>.
    </p>

    <h2>Related</h2>
    <p>
      <a href={page('terms')}>Terms of Use &amp; EULA</a>
      · <a href={page('support')}>Support</a>
      · <a href={page('privacy')}>Privacy Policy</a>
    </p>
  </LegalPage>
</Layout>
