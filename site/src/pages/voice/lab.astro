---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import { page } from '../../lib/asset';
import '../../styles/lab-shell.css';
---

<Layout
  title="Voice Lab — codescribe"
  description="Teacher and Seal Atlas, on demand. Live × Whisper × human. Not a daemon."
  path="voice/lab"
>
  <div class="lab-app-page">
    <Nav current="lab" />
    <div class="lab-shell">
      <header class="lab-nav">
        <span class="lab-brand">
          <span class="lab-wordmark">codescribe</span>
          <span class="lab-product">lab</span>
        </span>
        <nav class="lab-tabs" aria-label="Lab sections">
          <button type="button" class="lab-tab is-active" data-lab-tab="teach">Teach</button>
          <button type="button" class="lab-tab" data-lab-tab="atlas">Atlas</button>
        </nav>
        <div class="lab-runtime">
          <span class="runtime-dot" id="lab-dot"></span>
          <span id="lab-runtime-label">idle · on demand</span>
        </div>
      </header>

      <div class="lab-frame">
        <aside class="lab-sidebar">
          <section class="lab-block">
            <p class="lab-kicker">axiom</p>
            <p class="lab-muted">time × energy → <strong>faithful sentence</strong></p>
          </section>
          <section class="lab-block">
            <p class="lab-kicker">thesis</p>
            <aside id="thesis" class="thesis" hidden></aside>
            <p id="thesis-empty" class="lab-muted">Run teacher. Nothing loops.</p>
          </section>
          <section class="lab-block">
            <p class="lab-kicker">counts</p>
            <div id="stats" class="stats" hidden></div>
            <p id="stats-empty" class="lab-muted">Live · Whisper · human after a run.</p>
          </section>
          <section class="lab-block">
            <p class="lab-kicker">lexicon</p>
            <ul id="lexicon" class="lex">
              <li class="empty">No candidates until human disagrees with Whisper.</li>
            </ul>
          </section>
        </aside>

        <main id="main" class="lab-workspace">
          <section data-lab-pane="teach">
            <p class="lab-kicker">command</p>
            <h1>Teacher <span class="accent">on demand.</span></h1>
            <p class="lede">
              Same triangle as <code>codescribe-teacher</code>. Apple/live under-generates.
              Whisper over-fills. Human writes the sentence.
            </p>
            <div class="legs">
              <label>
                <span>Live / Apple</span>
                <textarea id="live" rows="8" placeholder="Under-generated assembly"></textarea>
              </label>
              <label>
                <span>Whisper</span>
                <textarea id="whisper" rows="8" placeholder="Final-pass over-fill"></textarea>
              </label>
              <label>
                <span>Human</span>
                <textarea id="human" rows="8" placeholder="Optional reference"></textarea>
              </label>
            </div>
            <div class="split">
              <div>
                <h3>Needs attention</h3>
                <div id="attention" class="table-wrap">
                  <p class="empty">Nothing yet. Teach is a command, not a loop.</p>
                </div>
              </div>
            </div>
          </section>

          <section data-lab-pane="atlas" hidden>
            <p class="lab-kicker">evidence</p>
            <h1>Seal Atlas</h1>
            <p class="lede">One take, one PCM clock. Loaded only when you open it.</p>
            <div id="atlas-stage" class="atlas-stage" hidden>
              <iframe title="Seal Atlas take 01" sandbox="allow-scripts" referrerpolicy="no-referrer"></iframe>
            </div>
            <p id="atlas-empty" class="empty">Use the toolbox to open take 01.</p>
          </section>
        </main>

        <aside class="lab-toolbox">
          <section class="lab-block" data-tools="teach">
            <p class="lab-kicker">toolbox</p>
            <h2>Teach</h2>
            <div class="lab-tool-stack">
              <button type="button" id="run-teach" class="primary">Run teacher</button>
              <button type="button" id="load-proof" class="ghost">Load proof take 01</button>
              <button type="button" id="clear-teach" class="ghost">Clear</button>
            </div>
          </section>
          <section class="lab-block" data-tools="atlas" hidden>
            <p class="lab-kicker">toolbox</p>
            <h2>Atlas</h2>
            <div class="lab-tool-stack">
              <button type="button" id="open-atlas" class="primary">Open take 01</button>
              <button type="button" id="close-atlas" class="ghost" hidden>Close atlas</button>
              <a class="ghost linkish" href="/voice/atlas/seal-atlas.take01.html" target="_blank" rel="noopener">open raw ↗</a>
            </div>
          </section>
          <section class="lab-block">
            <p class="lab-kicker">module</p>
            <p class="lab-muted">
              Not a sidecar. Loopback workbench lives at
              <code>127.0.0.1:8765/lab</code>.
            </p>
            <p class="foot-note"><a href={page('')}>← codescribe</a></p>
          </section>
        </aside>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { PROOF_TAKE, teach, type TeacherReport } from '../../lib/teacher/teach';

  const live = document.querySelector<HTMLTextAreaElement>('#live')!;
  const whisper = document.querySelector<HTMLTextAreaElement>('#whisper')!;
  const human = document.querySelector<HTMLTextAreaElement>('#human')!;
  const thesis = document.querySelector<HTMLElement>('#thesis')!;
  const thesisEmpty = document.querySelector<HTMLElement>('#thesis-empty')!;
  const stats = document.querySelector<HTMLElement>('#stats')!;
  const statsEmpty = document.querySelector<HTMLElement>('#stats-empty')!;
  const attention = document.querySelector<HTMLElement>('#attention')!;
  const lexicon = document.querySelector<HTMLElement>('#lexicon')!;
  const atlasStage = document.querySelector<HTMLElement>('#atlas-stage')!;
  const atlasEmpty = document.querySelector<HTMLElement>('#atlas-empty')!;
  const openAtlas = document.querySelector<HTMLButtonElement>('#open-atlas')!;
  const closeAtlas = document.querySelector<HTMLButtonElement>('#close-atlas')!;
  const runtimeLabel = document.querySelector<HTMLElement>('#lab-runtime-label')!;
  const runtimeDot = document.querySelector<HTMLElement>('#lab-dot')!;
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-lab-tab]'));
  const panes = Array.from(document.querySelectorAll<HTMLElement>('[data-lab-pane]'));
  const toolGroups = Array.from(document.querySelectorAll<HTMLElement>('[data-tools]'));

  function setSection(id: string) {
    tabs.forEach((tab) => tab.classList.toggle('is-active', tab.dataset.labTab === id));
    panes.forEach((pane) => {
      pane.hidden = pane.dataset.labPane !== id;
    });
    toolGroups.forEach((group) => {
      group.hidden = group.dataset.tools !== id;
    });
    runtimeLabel.textContent = id === 'atlas' ? 'atlas · on demand' : 'idle · on demand';
    runtimeDot.classList.toggle('live', id === 'atlas' && !atlasStage.hidden);
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => setSection(tab.dataset.labTab || 'teach'));
  });

  function render(report: TeacherReport) {
    thesis.hidden = false;
    thesisEmpty.hidden = true;
    thesis.textContent = report.thesis_summary;
    stats.hidden = false;
    statsEmpty.hidden = true;
    const hit =
      report.gap_hallucination_hit_rate == null
        ? 'n/a'
        : `${(report.gap_hallucination_hit_rate * 100).toFixed(0)}%`;
    stats.innerHTML = [
      ['live', report.live_token_count],
      ['whisper', report.whisper_token_count],
      ['equal', report.equal_ops],
      ['errors', report.whisper_errors_vs_human],
      ['at live-weak', report.whisper_errors_at_live_weak],
      ['hit-rate', hit],
    ]
      .map(([label, value]) => `<span><b>${value}</b>${label}</span>`)
      .join('');

    if (!report.attention.length) {
      attention.innerHTML = '<p class="empty">No spans. The legs already agree.</p>';
    } else {
      attention.innerHTML = `<table>
        <thead><tr><th>#</th><th>kind</th><th>live</th><th>whisper</th><th>human</th></tr></thead>
        <tbody>${report.attention
          .map(
            (span, index) => `<tr>
              <td>${index + 1}</td>
              <td><code>${span.kind}</code></td>
              <td>${escapeHtml(span.live_tokens.join(' '))}</td>
              <td>${escapeHtml(span.whisper_tokens.join(' '))}</td>
              <td>${escapeHtml(span.human_tokens.join(' '))}</td>
            </tr>`,
          )
          .join('')}</tbody></table>`;
    }

    if (!report.lexicon_hints.length) {
      lexicon.innerHTML =
        '<li class="empty">No candidates until a human reference disagrees with Whisper.</li>';
    } else {
      lexicon.innerHTML = report.lexicon_hints
        .map(
          (hint) =>
            `<li><code>${escapeHtml(hint.from_whisper)}</code> → <code>${escapeHtml(hint.to_human)}</code></li>`,
        )
        .join('');
    }
    runtimeLabel.textContent = 'teacher · last run';
  }

  function escapeHtml(value: string): string {
    return value
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;');
  }

  document.querySelector('#run-teach')?.addEventListener('click', () => {
    setSection('teach');
    render(
      teach({
        live: live.value,
        whisper: whisper.value,
        human: human.value.trim() || null,
        label: 'voice-lab on-demand',
      }),
    );
  });

  document.querySelector('#load-proof')?.addEventListener('click', () => {
    setSection('teach');
    live.value = PROOF_TAKE.live;
    whisper.value = PROOF_TAKE.whisper;
    human.value = PROOF_TAKE.human;
  });

  document.querySelector('#clear-teach')?.addEventListener('click', () => {
    setSection('teach');
    live.value = '';
    whisper.value = '';
    human.value = '';
    thesis.hidden = true;
    thesisEmpty.hidden = false;
    stats.hidden = true;
    statsEmpty.hidden = false;
    attention.innerHTML = '<p class="empty">Nothing yet. Teach is a command, not a loop.</p>';
    lexicon.innerHTML =
      '<li class="empty">No candidates until a human reference disagrees with Whisper.</li>';
    runtimeLabel.textContent = 'idle · on demand';
  });

  openAtlas.addEventListener('click', () => {
    setSection('atlas');
    const frame = atlasStage.querySelector('iframe');
    if (frame && !frame.getAttribute('src')) {
      frame.src = '/voice/atlas/seal-atlas.take01.html';
    }
    atlasStage.hidden = false;
    atlasEmpty.hidden = true;
    closeAtlas.hidden = false;
    openAtlas.hidden = true;
    runtimeDot.classList.add('live');
    runtimeLabel.textContent = 'atlas · take 01';
  });

  closeAtlas.addEventListener('click', () => {
    atlasStage.hidden = true;
    atlasEmpty.hidden = false;
    closeAtlas.hidden = true;
    openAtlas.hidden = false;
    runtimeDot.classList.remove('live');
    runtimeLabel.textContent = 'atlas · on demand';
  });
</script>

<style>
  .lab-workspace h1 {
    margin: 0 0 10px;
    font: 600 clamp(1.6rem, 3vw, 2.2rem)/1.05 var(--font-display);
    letter-spacing: -0.035em;
    color: var(--ink);
  }
  .accent { color: var(--terracotta); }
  .lede {
    max-width: 68ch;
    margin: 0 0 16px;
    color: var(--muted);
    font: 400 0.95rem/1.5 var(--font-display);
  }
  .lede code, .lab-muted code, .foot-note code {
    font-family: var(--font-mono);
    font-size: 0.86em;
    color: var(--terracotta-ink);
  }
  .legs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }
  label span {
    display: block;
    margin-bottom: 6px;
    font: 500 11px var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted-3);
  }
  textarea {
    width: 100%;
    resize: vertical;
    border: 1px solid var(--stroke);
    border-radius: var(--radius-input);
    background: var(--bg-soft);
    color: var(--ink-2);
    padding: 10px;
    font: 400 12px/1.45 var(--font-mono);
  }
  button, .linkish {
    height: 36px;
    padding: 0 14px;
    border-radius: var(--radius-input);
    border: 1px solid transparent;
    font: 600 13px var(--font-display);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
  }
  .primary { background: var(--terracotta); color: #0a0a0a; }
  .ghost, .linkish {
    background: transparent;
    color: var(--ink-2);
    border-color: var(--stroke-3);
    text-decoration: none;
  }
  .thesis {
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--ink-2);
    font: 400 13px/1.45 var(--font-display);
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }
  .stats span {
    padding: 7px 8px;
    border: 1px solid var(--stroke);
    border-radius: 8px;
    font: 400 10px var(--font-mono);
    color: var(--muted-3);
  }
  .stats b {
    display: block;
    color: var(--ink);
    font: 500 15px var(--font-mono);
  }
  .split { margin-top: 16px; }
  h3 {
    margin: 0 0 8px;
    font: 600 0.9rem var(--font-display);
  }
  .table-wrap { overflow: auto; }
  table {
    width: 100%;
    border-collapse: collapse;
    font: 400 12px/1.4 var(--font-mono);
  }
  th, td {
    border-bottom: 1px solid var(--hairline);
    padding: 7px 6px;
    text-align: left;
    vertical-align: top;
  }
  th { color: var(--muted-3); font-weight: 500; }
  code { color: var(--gold); }
  .lex { margin: 0; padding-left: 1.05rem; }
  .lex li { margin: 0 0 8px; font: 400 12px var(--font-mono); }
  .empty { color: var(--muted-3); font: 400 0.88rem var(--font-display); }
  .atlas-stage {
    min-height: 0;
    height: calc(100svh - 220px);
    border: 1px solid var(--stroke);
    border-radius: 10px;
    overflow: hidden;
    background: #eef1f4;
  }
  .atlas-stage iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }
  .foot-note {
    margin: 12px 0 0;
    color: var(--muted-3);
    font: 400 12px var(--font-mono);
  }
  .foot-note a { color: var(--ink-2); }
  .lab-muted strong { color: var(--olive-ink); font-weight: 500; }
  @media (max-width: 880px) {
    .legs { grid-template-columns: 1fr; }
    .atlas-stage { height: 52vh; }
  }
</style>
