  .demo-stage h3 { margin: 0 0 8px; font-size: 18px; }
  .demo-stage p { margin: 0; color: var(--muted-2); font-size: 15px; }
  .demo-buttons { display: flex; gap: 10px; }
  .btn-primary {
    background: var(--terracotta);
    color: #0a0a0a;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font: 600 13px var(--font-display);
    cursor: pointer;
  }
  .btn-secondary {
    background: transparent;
    color: var(--ink-2);
    border: 1px solid var(--stroke);
    border-radius: 8px;
    padding: 10px 20px;
    font: 500 13px var(--font-display);
    cursor: pointer;
  }
  .btn-primary:disabled { opacity: 0.5; cursor: default; }

  /* CTA */
  .cta-section {
    text-align: center;
    background: radial-gradient(ellipse at bottom, rgba(217, 119, 87, 0.1), transparent 75%);
  }
  .cta-desc {
    color: var(--muted-2);
    font-size: 17px;
    margin: 0 auto 28px;
    max-width: 580px;
  }
  .install-btn {
    display: inline-block;
    padding: 14px 28px;
    background: var(--terracotta);
    color: #0a0a0a;
    border-radius: 10px;
    font: 700 15px var(--font-display);
    text-decoration: none;
    transition: transform 0.15s ease;
  }
  .install-btn:hover {
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .cards-grid, .two-cols { grid-template-columns: 1fr; }
    .flow-arrow { display: none; }
    .mock-widget.midi, .mock-widget.full { width: 100%; }
    .hero { padding: 96px 18px 48px; }
    .section { padding: 60px 18px; }
  }
</style>

<script is:inline>
  // Mode switcher for the widget schematic
  const modes = document.querySelectorAll('[data-mode]');
  const widget = document.getElementById('widget-schematic');
  const widgetText = document.getElementById('widget-explanation');
  const modeDescriptions = {
    mini: {
      pl: 'Mini zostawia podstawowe przyciski i nie zajmuje miejsca na ekranie.',
      en: 'Mini leaves essential controls without occupying screen real estate.'
    },
    midi: {
      pl: 'Midi pokazuje szerszy pasek. W aplikacji pojawia się przy najechaniu wskaźnikiem na mini.',
      en: 'Midi reveals a wider bar with live waveform upon hovering over mini.'
    },
    full: {
      pl: 'Pełny widok mieści zachowaną transkrypcję lub rozmowę, z polem wiadomości na dole.',
      en: 'Full view holds complete transcript or conversation thread with compose bar.'
    }
  };

  let activeMode = 'mini';
  let currentLang = 'pl';

  modes.forEach(button => button.addEventListener('click', () => {
    activeMode = button.dataset.mode;
    widget.className = 'mock-widget ' + activeMode;
    widgetText.textContent = modeDescriptions[activeMode][currentLang];
    modes.forEach(item => {
      const selected = item === button;
      item.setAttribute('aria-pressed', String(selected));
      item.classList.toggle('active', selected);
    });
  }));

  // Demo step simulator
  const demoSteps = [
    {
      pl: ['Wysyłasz wiadomość', '„Podsumuj zmiany i wskaż następny krok”. Mikrofon pozostaje wyłączony.'],
      en: ['You send a message', '“Summarize changes and provide the next step”. Microphone remains off.']
    },
    {
      pl: ['Agent dostaje dzwonek (Bell)', 'Powiadomienie mówi, że w skrzynce jest koperta do odczytania. Sam dzwonek nie jest jeszcze przeczytaniem.'],
      en: ['Agent receives Bell wakeup', 'Notification signals that an envelope is in the mailbox. Wakeup itself is not yet read acknowledgment.']
    },
    {
      pl: ['Przeczytano (ACK)', 'Agent odczytał pełną wiadomość i zatwierdził dokładną dostawę przez cs-bus --ack. Potwierdzona pozycja schodzi z kolejki.'],
      en: ['Read (ACK signed)', 'Agent consumes the envelope and confirms delivery via cs-bus --ack. Item is cleared from pending queue.']
    },
    {
      pl: ['Pojawia się odpowiedź', 'Tekst wraca do rozmowy w overlay. Jeśli skonfigurowano profil głosu, audio odtwarza się w tle.'],
      en: ['Response arrives', 'Text returns to the overlay thread. If TTS voice profile is configured, speech streams in background.']
    },
    {
      pl: ['Spóźniony dzwonek (Idempotencja)', 'Agent sprawdza skrzynkę po dzwonku. Gdy jest pusta, nie powtarza zadania i nie dubluje odpowiedzi.'],
      en: ['Late wakeup check (Idempotent)', 'Agent inspects mailbox on wakeup. If already empty, it cleanly exits without duplicate reply.']
    }
  ];

  let demoStepIndex = 0;
  const demoNext = document.getElementById('demo-next');
  const demoReset = document.getElementById('demo-reset');
  const demoOutput = document.getElementById('demo-output');
  const demoCount = document.getElementById('demo-count');

  function renderDemoStep() {
    const cur = demoSteps[demoStepIndex][currentLang];
    const h3 = document.createElement('h3');
    const p = document.createElement('p');
    h3.textContent = cur[0];
    p.textContent = cur[1];
    demoOutput.replaceChildren(h3, p);
    demoCount.textContent = (currentLang === 'pl' ? 'Krok ' : 'Step ') + (demoStepIndex + 1) + ' / ' + demoSteps.length;
    demoNext.disabled = demoStepIndex === demoSteps.length - 1;
  }

  demoNext.addEventListener('click', () => {
    if (demoStepIndex < demoSteps.length - 1) {
      demoStepIndex += 1;
      renderDemoStep();
    }
  });

  demoReset.addEventListener('click', () => {
    demoStepIndex = 0;
    renderDemoStep();
  });

  // Language switcher (PL / EN)
  const langBtns = document.querySelectorAll('.lang-btn');
  const langTexts = document.querySelectorAll('.lang-text');

  function applyLanguage(lang) {
    currentLang = lang;
    langBtns.forEach(btn => {
      const active = btn.dataset.lang === lang;
      btn.classList.toggle('active', active);
      btn.setAttribute('aria-pressed', String(active));
    });

    langTexts.forEach(el => {
      const text = el.getAttribute('data-' + lang);
      if (text) {
        if (text.includes('<br/>') || text.includes('<code>')) {
          el.innerHTML = text;
        } else {
          el.textContent = text;
        }
      }
    });

    if (widgetText && modeDescriptions[activeMode]) {
      widgetText.textContent = modeDescriptions[activeMode][lang];
    }
    renderDemoStep();
  }

  langBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      applyLanguage(btn.dataset.lang);
      try { localStorage.setItem('cs-guide-lang', btn.dataset.lang); } catch (e) {}
    });
  });

  try {
    const saved = localStorage.getItem('cs-guide-lang');
    if (saved === 'en' || saved === 'pl') {
      applyLanguage(saved);
    }
  } catch (e) {}
</script>
