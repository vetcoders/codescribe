---
// Install section (WEBSITE_SPEC §4.12). Repo URL brand-corrected to
// github.com/vetcoders/codescribe (the reference render still had the old
// camelCase path).
// The build resolves one published GitHub release for every download CTA.
// Its pinned asset URL, version and size stay together in src/lib/release.ts.
import { SITE_VERSION, DOWNLOAD_URL, DOWNLOAD_SIZE } from '../lib/release';
import { page } from '../lib/asset';
---

<section class="section install" id="install" data-screen-label="Install" aria-labelledby="install-title">
  <div class="container">
    <p class="eyebrow eyebrow--plain">macOS · APPLE SILICON · v{SITE_VERSION}</p>
    <h2 id="install-title">Start with local speech recognition.</h2>
    <p class="dl-row">
      <a class="btn btn--primary" href={DOWNLOAD_URL}>Download Codescribe.dmg</a>
      <span class="dl-note">published release · {DOWNLOAD_SIZE} · <a href="https://github.com/vetcoders/codescribe#install-from-source">build from source: see README</a></span>
    </p>
    <p class="setup-note">Install the app, grant the speech permissions, and choose your shortcuts.
      Whisper needs a local model download. AI rewriting and agent replies require a configured provider.
      <a href={page("license")}>Get an open-beta licence</a> · <a href={page("privacy")}>Read the privacy policy</a>.</p>
    <div class="meta-row">
      <span>· Apple live speech</span>
      <span>· optional Whisper model</span>
      <span>· tray + overlay</span>
      <span>· FSL-1.1-ALv2</span>
    </div>
  </div>
</section>

<style>
  .install { padding: 110px 24px; }
  .dl-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
    margin: 0 0 22px;
  }
  .setup-note { font: 400 15px / 1.65 var(--font-display); color: var(--muted-2); margin: 20px 0; }
  .dl-note {
    font: 500 12px / 1 var(--font-mono);
    color: var(--ink-dim, #9a958a);
  }
  .dl-note a { color: inherit; }
  /* Literal casing for this eyebrow (spec §4.12): keep "macOS" and the
     version string as written instead of the global .eyebrow uppercase
     transform. */
  .eyebrow--plain { text-transform: none; }
  .container {
    max-width: 680px;
    text-align: center;
  }
  h2 {
    font: 700 clamp(30px, 4.4vw, 44px) / 1 var(--font-display);
    letter-spacing: -0.03em;
    margin: 14px 0 26px;
    color: var(--ink);
  }
  @media (max-width: 480px) {
    .install { padding: 84px 20px; }
  }
</style>
