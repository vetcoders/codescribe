---
// Install section (WEBSITE_SPEC §4.12). Repo URL brand-corrected to
// github.com/vetcoders/codescribe (the reference render still had the old
// camelCase path).
// The download link is pinned so the button can never serve a different
// artifact than the version it advertises (review P1-4). The pin now lives in
// src/lib/release.ts so Hero and Install cannot drift apart.
import { SITE_VERSION, DOWNLOAD_URL, DOWNLOAD_SIZE } from '../lib/release';
---

<section class="section install" id="install" data-screen-label="Install" aria-labelledby="install-title">
  <div class="container">
    <p class="eyebrow eyebrow--plain">macOS · APPLE SILICON · v{SITE_VERSION}</p>
    <h2 id="install-title">Local-first. Cloud opt-in.</h2>
    <p class="dl-row">
      <a class="btn btn--primary" href={DOWNLOAD_URL}>Download Codescribe.dmg</a>
      <span class="dl-note">signed &amp; notarized · {DOWNLOAD_SIZE} · <a href="https://github.com/vetcoders/codescribe#install-from-source">build from source: see README</a></span>
    </p>
    <div class="meta-row">
      <span>· local whisper preview</span>
      <span>· configurable final pass</span>
      <span>· tray + overlay</span>
      <span>· FSL-1.1-ALv2</span>
    </div>
  </div>
</section>

<style>
  .install { padding: 110px 24px; }
  .dl-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
    margin: 0 0 22px;
  }
  .dl-note {
    font: 500 12px / 1 var(--font-mono);
    color: var(--ink-dim, #9a958a);
  }
  .dl-note a { color: inherit; }
  /* Literal casing for this eyebrow (spec §4.12): keep "macOS" and the
     version string as written instead of the global .eyebrow uppercase
     transform. */
  .eyebrow--plain { text-transform: none; }
  .container {
    max-width: 680px;
    text-align: center;
  }
  h2 {
    font: 700 clamp(30px, 4.4vw, 44px) / 1 var(--font-display);
    letter-spacing: -0.03em;
    margin: 14px 0 26px;
    color: var(--ink);
  }
  @media (max-width: 480px) {
    .install { padding: 84px 20px; }
  }
</style>
