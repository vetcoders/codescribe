---
// Describe user controls without turning implementation invariants into promises.
const features = [
  { n: '01', title: 'Review as you speak', body: 'A live transcript in the overlay lets you follow the capture and review the final text before using it.' },
  { n: '02', title: 'Choose how text is delivered', body: 'Safe, comfort, and off paste modes let you decide when text is inserted and when it stays available to copy.' },
  { n: '03', title: 'Use your vocabulary', body: 'Add names and technical terms to the custom lexicon. Registered variants help normalize recognition results.' },
  { n: '04', title: 'Bring the relevant context', body: 'Attach selected text or files to a conversation so your question arrives with the material you want the agent to use.' },
  { n: '05', title: 'Choose local or remote services', body: 'Local speech recognition runs on your Mac. AI formatting, agent calls, and cloud transcription use the services you explicitly configure.' },
  { n: '06', title: 'Talk to named agent sessions', body: 'Connect supported agent runtimes to numbered channels. Read replies in the overlay and enable spoken replies with a configured speech provider.' },
];
---

<section class="section features" id="features" data-screen-label="Features" aria-labelledby="features-title">
  <div class="container">
    <div class="head">
      <p class="eyebrow">WORKFLOW CONTROLS</p>
      <h2 id="features-title">Fit the workflow to the task.</h2>
      <p class="sub">
        Configure speech, delivery, vocabulary, and context from the same app.
        Connected agents require the agent bridge and a supported runtime.
      </p>
    </div>

    <ol class="grid">
      {features.map((f) => (
        <li class="card">
          <span class="card__n" aria-hidden="true">{f.n}</span>
          <h3>{f.title}</h3>
          <p>{f.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .features { padding: 120px 24px; border-top: 1px solid var(--hairline); }
  .container { max-width: 1100px; margin: 0 auto; }
  .head {
    text-align: center;
    margin-bottom: 48px;
  }
  h2 {
    font: 700 clamp(32px, 5vw, 50px) / 1.05 var(--font-display);
    letter-spacing: -0.03em;
    margin: 14px 0 14px;
    color: var(--ink);
  }
  .sub {
    font: 400 16px / 1.55 var(--font-display);
    color: var(--muted-2);
    max-width: 520px;
    margin: 0 auto;
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 14px;
  }
  .card {
    position: relative;
    padding: 22px 20px 20px;
    border-radius: 14px;
    background: var(--bg-card);
    border: 1px solid var(--stroke);
    min-height: 168px;
    transition: border-color 0.25s ease, background 0.25s ease;
  }
  .card:hover {
    border-color: rgba(217, 119, 87, 0.35);
    background: rgba(255, 255, 255, 0.035);
  }
  .card__n {
    font: 600 11px / 1 var(--font-mono);
    letter-spacing: 0.08em;
    color: var(--terracotta-ink);
    display: block;
    margin-bottom: 12px;
  }
  h3 {
    font: 600 17px / 1.25 var(--font-display);
    letter-spacing: -0.02em;
    margin: 0 0 10px;
    color: var(--ink);
  }
  .card p {
    font: 400 13.5px / 1.5 var(--font-display);
    color: var(--muted);
    margin: 0;
  }
  @media (max-width: 640px) {
    .features { padding: 80px 18px; }
    .card { min-height: 0; }
  }
</style>
