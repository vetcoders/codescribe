---
// Twelve product-true differentiators — grounded in runtime, not brochure fluff.
// Each item maps to a shipped surface (engine, overlay, agent, or onboarding).
const features = [
  {
    n: '01',
    title: 'Multi-selection context buckets',
    body: 'Combo hotkeys during dictation capture multiple selections into context for agentic chat and daily transcript flows — not one clip, not one paste.',
  },
  {
    n: '02',
    title: 'Apple live freezed + append',
    body: 'Multi-utterance live assembly: previous finals freeze, current interim appends. Long Polish thoughts stay coherent instead of collapsing to a tail.',
  },
  {
    n: '03',
    title: 'Live × Whisper merge fill',
    body: 'Apple is the floor of truth; Whisper fills gaps. Full-replace is forbidden — correct tokens are never deleted by a second pass.',
  },
  {
    n: '04',
    title: 'On-device Polish as foundation',
    body: 'SFSpeechRecognizer on-device for pl-PL is a product path, not a legacy fallback. Speech never has to leave the Mac for live dictation.',
  },
  {
    n: '05',
    title: 'Overlay over any focused app',
    body: 'Global hotkeys summon a dictation surface on top of whatever owns focus — editor, mail, browser, terminal — without a mode switch.',
  },
  {
    n: '06',
    title: 'Hold · toggle · hybrid triggers',
    body: 'Pick how recording starts: press-and-hold, toggle, or hybrid. Hands-free silence windows when you need them; snappy hold when you don’t.',
  },
  {
    n: '07',
    title: 'Selection-aware rewrite in place',
    body: 'Highlight text anywhere, speak the intent (“make it formal”), and the result lands back in the same field — no copy-paste theatre.',
  },
  {
    n: '08',
    title: 'Agentic chat + MCP tools',
    body: 'Basic dictation or full agentic lane: persistent chat, tool substrate, and voice that can dispatch work instead of only typing it.',
  },
  {
    n: '09',
    title: 'Teacher dictionary that learns',
    body: 'Corrections become live lexicon rules. Teach mines the store into variant→canonical pairs the post-processor actually applies.',
  },
  {
    n: '10',
    title: 'Honest runtime truth',
    body: 'Permission matrix, Active STT status, and Speech Recognition TCC are live probes — not static “looks fine” badges that lie.',
  },
  {
    n: '11',
    title: 'Local Whisper when you want it',
    body: 'Slim daily build ships Apple live without a gigabyte model. Whisper downloads from Settings when you want file-final fill or offline paths.',
  },
  {
    n: '12',
    title: 'First-run that actually unlocks speech',
    body: 'Setup wizard includes Speech Recognition with the same grant path as Mic and Accessibility — so Apple live works after install, not after a support ticket.',
  },
];
---

<section class="section features" id="features" data-screen-label="Features" aria-labelledby="features-title">
  <div class="container">
    <div class="head">
      <p class="eyebrow">TWELVE THAT MATTER</p>
      <h2 id="features-title">Not voice typing. A voice control layer.</h2>
      <p class="sub">
        Twelve surfaces that separate codescribe from a generic STT box — each one
        is in the product today, not a roadmap poster.
      </p>
    </div>

    <ol class="grid">
      {features.map((f) => (
        <li class="card">
          <span class="card__n" aria-hidden="true">{f.n}</span>
          <h3>{f.title}</h3>
          <p>{f.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .features { padding: 120px 24px; border-top: 1px solid var(--hairline); }
  .container { max-width: 1100px; margin: 0 auto; }
  .head {
    text-align: center;
    margin-bottom: 48px;
  }
  h2 {
    font: 700 clamp(32px, 5vw, 50px) / 1.05 var(--font-display);
    letter-spacing: -0.03em;
    margin: 14px 0 14px;
    color: var(--ink);
  }
  .sub {
    font: 400 16px / 1.55 var(--font-display);
    color: var(--muted-2);
    max-width: 520px;
    margin: 0 auto;
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 14px;
  }
  .card {
    position: relative;
    padding: 22px 20px 20px;
    border-radius: 14px;
    background: var(--bg-card);
    border: 1px solid var(--stroke);
    min-height: 168px;
    transition: border-color 0.25s ease, background 0.25s ease;
  }
  .card:hover {
    border-color: rgba(217, 119, 87, 0.35);
    background: rgba(255, 255, 255, 0.035);
  }
  .card__n {
    font: 600 11px / 1 var(--font-mono);
    letter-spacing: 0.08em;
    color: var(--terracotta-ink);
    display: block;
    margin-bottom: 12px;
  }
  h3 {
    font: 600 17px / 1.25 var(--font-display);
    letter-spacing: -0.02em;
    margin: 0 0 10px;
    color: var(--ink);
  }
  .card p {
    font: 400 13.5px / 1.5 var(--font-display);
    color: var(--muted);
    margin: 0;
  }
  @media (max-width: 640px) {
    .features { padding: 80px 18px; }
    .card { min-height: 0; }
  }
</style>
