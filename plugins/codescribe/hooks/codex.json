{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -E \"${PLUGIN_ROOT}/scripts/openai.py\" --hook",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -E \"${PLUGIN_ROOT}/scripts/openai.py\" --hook",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -E \"${PLUGIN_ROOT}/scripts/openai.py\" --hook",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -E \"${PLUGIN_ROOT}/scripts/openai.py\" --hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
