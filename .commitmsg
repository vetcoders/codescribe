# The canonical Vetcoders commit message format.

# [<agent>/<runtime>] <type>(<scope>): <subject> // scoped and easily understood subject line

# <body...> // at least few sentences about what you changed and why

# Authored-By: <agent> <agents@vetcoders.io> // only our email in the hook
# session_id:
# time: YYYY-MM-DDTHH:MM:SS±HH:MM
# runtime: <runtime>

# -----
