#!/usr/bin/env -S python3 -E
"""x9say TEXT — X9bus system voice: Carina (xAI), speed 1.0.
x9say TEXT --provider codex|claude-code --session SESSION [--reply-to DELIVERY_ID] [voice options].
x9say auth --provider xai|openai|deepinfra|custom --login-type oauth|key|device-code
x9say --version — installed helper version and source commit.

Without --provider/--session, publishes as Codescribe (codescribe/system).
--voice/--speed/--tts-vendor override CS_SAY_VOICE/CS_SAY_SPEED/CS_SAY_TTS_VENDOR,
which override the system defaults. Agent profiles keep their own defaults.
System announcements bypass agent mutes; live-take playback safety still applies.

Reply text is durable before speech. Use --reply-to with the accepted envelope
ID; omission marks the reply unsolicited. Explicit Play/Stop uses x9bus
--play-reply/--stop-reply with an exact --playback-ticket.

Authentication is independent of the app. xAI supports OAuth and device-code
through the Grok CLI. All four providers support a hidden API-key prompt stored
in macOS Keychain. Other OAuth/device-code combinations are not supported.
DeepInfra/custom credentials are stored only; speech currently uses xAI/OpenAI.
Run x9say auth --help for examples. Never put a token on the command line.
`cs-say` remains a compatibility alias for older agent setups.
"""

import os
from pathlib import Path
import sys
import shutil
import argparse

# Started with -E; the x9bus it execs runs without it and must not see the
# host's PYTHON* variables.
for name in [name for name in os.environ if name.startswith("PYTHON")]:
    del os.environ[name]

arguments = sys.argv[1:]
entrypoint = "x9say"
if arguments[:1] == ["--entrypoint"] and len(arguments) >= 2:
    entrypoint, *arguments = arguments[1:]
if entrypoint not in {"x9say", "cs-say"}:
    raise SystemExit("x9say: invalid internal entrypoint")

if arguments[:1] == ["auth"]:
    parser = argparse.ArgumentParser(
        prog=f"{entrypoint} auth",
        description="Authenticate independently of the Codescribe app.",
        epilog=f"Examples: {entrypoint} auth --provider xai --login-type oauth; "
        f"{entrypoint} auth --provider xai --login-type device-code; "
        f"{entrypoint} auth --provider openai --login-type key. "
        "xAI OAuth/device-code requires the Grok CLI. Key login uses a hidden "
        "macOS Keychain prompt for every provider. DeepInfra/custom are credential "
        "storage only; speech currently supports xAI/OpenAI.",
    )
    parser.add_argument(
        "--provider", choices=("xai", "openai", "deepinfra", "custom"), required=True
    )
    parser.add_argument(
        "--login-type", choices=("oauth", "key", "device-code"), required=True
    )
    auth = parser.parse_args(arguments[1:])
    if auth.login_type == "key":
        executable = "/usr/bin/security"
        if not Path(executable).is_file():
            parser.error("key login requires macOS Keychain")
        # -w LAST prompts privately; the credential never appears in argv.
        os.execv(
            executable,
            [
                executable,
                "add-generic-password",
                "-U",
                "-s",
                "com.vetcoders.codescribe",
                "-a",
                f"LLM_{auth.provider.upper()}_API_KEY",
                "-w",
            ],
        )
    if auth.provider != "xai":
        parser.error(
            f"{auth.provider} supports --login-type key; OAuth/device-code is available only for xAI"
        )
    executable = shutil.which("grok")
    if executable is None:
        print(
            f"{entrypoint} auth requires the Grok CLI for xAI authentication.", file=sys.stderr
        )
        sys.exit(3)
    options = {"oauth": ["--oauth"], "device-code": ["--device-auth"]}
    os.execv(executable, [executable, "login", *options[auth.login_type]])
if arguments == ["--version"]:
    os.execv(
        sys.executable,
        [
            sys.executable,
            str(Path(__file__).resolve().with_name("x9bus")),
            "--entrypoint",
            entrypoint,
            "--version",
        ],
    )
if not arguments or arguments[0] in ("--help", "-h"):
    print(__doc__)
    sys.exit(0 if arguments else 2)
os.execv(
    sys.executable,
    [
        sys.executable,
        str(Path(__file__).resolve().with_name("x9bus")),
        "--entrypoint",
        entrypoint,
        "--say",
        *arguments,
    ],
)
