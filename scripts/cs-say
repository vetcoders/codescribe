#!/usr/bin/env python3
"""cs-say TEXT --provider codex|claude-code --session SESSION [voice options]."""
import os
from pathlib import Path
import sys

if len(sys.argv) < 2 or sys.argv[1] in ("--help", "-h"):
    print(__doc__)
    sys.exit(0 if len(sys.argv) > 1 else 2)
os.execv(sys.executable, [sys.executable, str(Path(__file__).resolve().with_name("bus-demux.py")), "--say", *sys.argv[1:]])
