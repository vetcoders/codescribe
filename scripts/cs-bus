#!/usr/bin/env -S python3 -E
"""Compatibility alias for the primary x9bus command."""
import os
from pathlib import Path
import sys

for name in [name for name in os.environ if name.startswith("PYTHON")]:
    del os.environ[name]

os.execv(
    sys.executable,
    [
        sys.executable,
        str(Path(__file__).resolve().with_name("x9bus")),
        "--entrypoint",
        "cs-bus",
        *sys.argv[1:],
    ],
)
