{
  "schema": "codescribe.lease-identity-vectors.v1",
  "rule": "lease_id = first 32 hex digits of SHA-256(provider_token(provider) + NUL + provider_session_id); provider_token = trim ASCII whitespace (space, tab, LF, CR, FF), require [A-Za-z0-9][A-Za-z0-9-]{0,63}, then ASCII lower-case; any other provider, any non-ASCII character included, is refused (normalized_provider and lease_id null); the session is taken byte for byte, never trimmed. Stated once at provider_token in scripts/bus-demux.py",
  "vectors": [
    {
      "case": "plain",
      "provider": "codex",
      "provider_session_id": "abc",
      "normalized_provider": "codex",
      "lease_id": "0500ad38d366d7c1f7bc8f7e7e1b03a5"
    },
    {
      "case": "provider padded with spaces and a tab",
      "provider": "  Codex\t",
      "provider_session_id": "abc",
      "normalized_provider": "codex",
      "lease_id": "0500ad38d366d7c1f7bc8f7e7e1b03a5"
    },
    {
      "case": "provider with a trailing newline",
      "provider": "codex\n",
      "provider_session_id": "abc",
      "normalized_provider": "codex",
      "lease_id": "0500ad38d366d7c1f7bc8f7e7e1b03a5"
    },
    {
      "case": "upper-case provider",
      "provider": "CLAUDE-CODE",
      "provider_session_id": "S-1",
      "normalized_provider": "claude-code",
      "lease_id": "0423e63b3976eb1898935bac51db2b25"
    },
    {
      "case": "mixed-case provider",
      "provider": "Claude-Code",
      "provider_session_id": "S-1",
      "normalized_provider": "claude-code",
      "lease_id": "0423e63b3976eb1898935bac51db2b25"
    },
    {
