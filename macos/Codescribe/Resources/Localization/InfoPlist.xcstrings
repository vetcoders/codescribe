    "CFBundleName" : {
      "comment" : "Product name in the app menu, About panel and standard menu items. Identical in every language.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "X9Bus"
          }
