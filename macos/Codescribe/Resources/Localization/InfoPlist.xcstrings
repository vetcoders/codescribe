      }
    },
    "NSAppleEventsUsageDescription" : {
      "comment" : "System permission prompt: why X9Bus sends Apple Events to other apps.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "X9Bus uses Apple Events to deliver transcribed text and lower Spotify's volume during recording, then restore it."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "X9Bus używa Apple Events do wstawiania transkrybowanego tekstu oraz ściszania Spotify podczas nagrywania i przywracania jego głośności."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "System permission prompt: why X9Bus needs the microphone.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "X9Bus transcribes your speech locally with on-device Whisper."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "X9Bus transkrybuje Twoją mowę lokalnie za pomocą modelu Whisper działającego na tym Macu."
          }
        }
      }
    },
    "NSScreenCaptureUsageDescription" : {
      "comment" : "System permission prompt: why X9Bus captures the screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "X9Bus captures the screen when you ask the assistant to look at what is currently on screen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "X9Bus przechwytuje obraz ekranu tylko wtedy, gdy poprosisz Agenta, aby sprawdził, co jest na ekranie."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "System permission prompt: why X9Bus uses on-device speech recognition.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "X9Bus uses on-device speech recognition (including Polish) to turn your dictation into text without sending audio to the cloud."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "X9Bus korzysta z rozpoznawania mowy na urządzeniu, także w języku polskim, aby zamieniać dyktowanie na tekst bez wysyłania nagrań do chmury."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
