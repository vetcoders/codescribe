    },
    "Text verification incomplete" : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekst nie został zweryfikowany."
          }
        }
      }
    },
    "Text verification is incomplete; this receipt provides no usable uncovered speech interval. You can review and recover the available text." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weryfikacja tekstu jest niepełna. Nie można wskazać dokładnego fragmentu, którego brakuje w transkrypcji."
