    },
    "The configured device is present and selected by the recorder." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skonfigurowane urządzenie jest dostępne i używane do nagrywania."
          }
        }
      }
    },
    "The configured input" : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wejście wybrane w ustawieniach"
          }
        }
      }
    },
    "The connected account covers model requests, but the model list needs this provider's API key. Keep the current model or enter a model ID below." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Połączone konto obsługuje żądania do modelu, ale lista modeli wymaga klucza API tego dostawcy. Zachowaj obecny model albo wpisz identyfikator modelu poniżej."
          }
        }
      }
    },
    "The custom prompt file could not be read, so the built-in prompt is in use." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się odczytać pliku własnego promptu, dlatego używany jest wbudowany prompt."
          }
        }
      }
    },
    "The download continues in the background when you leave this step or close setup. Check its progress in Settings." : {
      "comment" : "Whisper download never blocks navigation, closing the wizard or completing setup",
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pobieranie trwa w tle także po przejściu do kolejnego kroku lub zamknięciu konfiguracji. Postęp znajdziesz w Ustawieniach."
          }
        }
      }
    },
    "The endpoint is normalized to the wire's canonical path on save." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przy zapisie adres zostanie dostosowany do ścieżki wybranego API."
          }
        }
      }
    },
    "The existing transcript is still here." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transkrypcja jest nadal dostępna."
          }
        }
      }
    },
    "The file exists but could not be read." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plik istnieje, ale nie udało się go odczytać."
          }
        }
      }
    },
    "The file exists but is empty, so the built-in prompt is in use." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plik istnieje, ale jest pusty, dlatego używany jest wbudowany prompt."
          }
        }
      }
    },
    "The handover came back. These words are retained here — recover them before the next take." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekst nie został przekazany. Został zachowany tutaj — odzyskaj go przed kolejnym nagraniem."
          }
        }
      }
    },
    "The installation path could not be inspected." : {
      "comment" : "Agent bridge refuses an installation path it cannot inspect",
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można sprawdzić ścieżki instalacji."
          }
        }
      }
    },
    "The key is verified locally and stored in the macOS Keychain." : {
      "comment" : "License panel footnote: how the key is checked and where it lives",
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klucz jest weryfikowany lokalnie i przechowywany w Pęku kluczy macOS."
          }
        }
      }
    },
    "The local FP16 bundle is missing or invalid. Local power is explicitly not ready until validation passes." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brakuje lokalnych plików modelu FP16 lub są one nieprawidłowe. Tryb lokalny będzie niedostępny, dopóki weryfikacja nie zakończy się pomyślnie."
          }
        }
      }
    },
    "The local engine does not support quantized (Q8) models." : {
      "comment" : "Whisper model refusal: quantized weights",
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokalny silnik nie obsługuje modeli skwantyzowanych (Q8)."
          }
        }
      }
    },
    "The middle mouse button follows the same press, hold and tap rules as Fn. Its ordinary click can still reach the app in front." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Środkowy przycisk myszy działa według tych samych reguł naciśnięcia, przytrzymania i tapnięcia co Fn. Jego zwykłe kliknięcie może nadal dotrzeć do aktywnej aplikacji."
          }
        }
      }
    },
    "The model behind the Agent and the voice assistant" : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model obsługujący Agenta i asystenta głosowego"
          }
        }
      }
    },
    "The model failed validation. See Model details." : {
      "comment" : "Whisper model refusal: generic",
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model nie przeszedł weryfikacji. Zobacz Szczegóły modelu."
          }
        }
      }
    },
    "The model files are incomplete. See Model details." : {
      "comment" : "Whisper model refusal: files missing",
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pliki modelu są niekompletne. Zobacz Szczegóły modelu."
          }
        }
      }
    },
    "The model's tokenizer is invalid. See Model details." : {
      "comment" : "Whisper model refusal: tokenizer validation failed",
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokenizer modelu jest nieprawidłowy. Zobacz Szczegóły modelu."
          }
        }
      }
    },
    "The provider returned no models. Enter a model ID below." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostawca nie zwrócił żadnych modeli. Wpisz identyfikator modelu poniżej."
          }
        }
      }
    },
    "The selected model cannot be removed." : {
      "comment" : "Whisper tab storage row: why Remove is disabled",
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybranego modelu nie można usunąć."
          }
        }
      }
    },
    "The selected model cannot be resolved; the next recording has no model to load." : {
      "comment" : "Whisper tab: resolution failed",
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można odnaleźć wybranego modelu; następne nagranie nie ma modelu do załadowania."
          }
        }
      }
    },
    "The server URL is invalid. Enter a full HTTP or HTTPS URL with a hostname." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adres serwera jest nieprawidłowy. Wpisz pełny adres HTTP lub HTTPS z nazwą hosta."
          }
        }
      }
    },
    "The shared recorder is preparing this take." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przetwarzanie nagrania…"
          }
        }
      }
    },
    "The shared recorder is processing this take. Wait before starting another." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trwa przetwarzanie tego nagrania. Poczekaj przed rozpoczęciem kolejnego."
          }
        }
      }
    },
    "The signed app does not contain the agent bridge payload." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta wersja Codescribe nie zawiera komponentu Agent Bridge."
          }
        }
      }
    },
    "The text received so far is still here. It may be incomplete." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotychczasowy tekst jest dostępny, ale może być niepełny."
          }
        }
      }
    },
    "The three mode gestures are saved with the button below. Every other setting here applies as soon as you change it." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trzy gesty trybów zapisujesz przyciskiem poniżej. Pozostałe ustawienia na tej karcie działają od razu po zmianie."
          }
        }
      }
    },
    "The token is stored in the macOS Keychain, never in mcp.json." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token jest zapisywany w pęku kluczy macOS, nie w pliku mcp.json."
          }
        }
      }
    },
    "The transcriber was unsure of this word" : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transkrypcja nie rozpoznała tego słowa z wystarczającą pewnością"
          }
        }
      }
    },
    "The visible take has no session identity" : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widoczne nagranie nie jest przypisane do żadnej sesji"
          }
        }
      }
    },
    "The visible take's audio is unavailable" : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dźwięk widocznego nagrania jest niedostępny"
          }
        }
      }
    },
    "Thermal throttling" : {
      "comment" : "Tray status: the host is too hot to run speech-to-text at full speed",
      "localizations" : {
        "pl" : {
