    "Moves %lld Agent threads and %lld Agent files to Trash." : {
      "comment" : "Agent reset impact; each count needs its own plural variation",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moves %#@threads@ and %#@files@ to Trash."
          },
          "substitutions" : {
            "files" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg Agent file"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg Agent files"
                    }
                  }
                }
              }
            },
            "threads" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg Agent thread"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg Agent threads"
                    }
                  }
                }
              }
            }
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przenosi %#@threads@ i %#@files@ do Kosza."
          },
          "substitutions" : {
            "files" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "few" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg pliki Agenta"
                    }
                  },
                  "many" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg plików Agenta"
                    }
                  },
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg plik Agenta"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg pliku Agenta"
                    }
                  }
                }
              }
            },
            "threads" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "few" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg wątki Agenta"
                    }
                  },
                  "many" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg wątków Agenta"
                    }
                  },
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg wątek Agenta"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg wątku Agenta"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "Moves only Agent conversations, runtime identity, MCP and tool state to Trash. Agent provider and MCP connector secrets are deleted permanently. Recordings, transcriptions, dictionary, lexicon, quality reports, prompts, audio, hotkeys, dictation, license, and macOS permissions are preserved." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuwa dane Agenta: rozmowy, stan sesji, konfigurację MCP i stan narzędzi.\n\nKlucze dostawców Agenta i dane dostępowe konektorów MCP zostaną trwale usunięte. Pozostałe dane Codescribe — w tym nagrania, transkrypcje, słownik, leksykon, raporty jakości, prompty, audio, skróty klawiszowe, ustawienia dyktowania, licencja i uprawnienia macOS — pozostaną bez zmian."
          }
        }
      }
    },
    "Moves only mcp.json to Trash after confirmation." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po potwierdzeniu przenosi do Kosza tylko plik mcp.json."
          }
        }
      }
    },
    "Moves only ~/.codescribe/mcp.json to Trash. Recordings, transcripts, threads, preferences, and API keys stay untouched." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do Kosza trafi tylko ~/.codescribe/mcp.json. Nagrania, transkrypcje, wątki, ustawienia i klucze API pozostaną nietknięte."
          }
        }
      }
    },
    "Moves recordings, transcript history, conversations, logs, preferences, and local configuration to Trash so they can be recovered. Your assistive.txt and formatting.txt base prompts are preserved by default." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przenosi nagrania, historię transkrypcji, rozmowy, logi, preferencje i lokalną konfigurację do kosza.\nTwoje własne prompty Agenta i formatowania (`assistive.txt` i `formatting.txt`) pozostaną bez zmian."
          }
        }
      }
    },
