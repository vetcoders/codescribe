      }
    },
    "One tap starts dictation and the next tap stops it. Holding records only while you hold." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedno naciśnięcie uruchamia dyktowanie, kolejne je zatrzymuje. Przytrzymanie nagrywa tylko tak długo, jak trzymasz klawisz."
          }
        }
      }
    },
    "Only %@ will change: its custom file is removed and the built-in prompt takes over. The previous version remains recoverable in the prompt backups folder." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmieni się tylko %@: własny plik zostanie usunięty, a w użyciu będzie wbudowany prompt. Poprzednią wersję można odzyskać z folderu kopii zapasowych promptów."
          }
