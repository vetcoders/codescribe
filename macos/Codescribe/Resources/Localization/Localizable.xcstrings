    "A longer gap in speech opens a new sentence in pasted dictation." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dłuższa przerwa w mowie zaczyna nowe zdanie we wklejanym tekście."
          }
