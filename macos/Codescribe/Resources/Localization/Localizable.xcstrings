    },
    "The cloud provider you agreed to." : {
      "comment" : "ASR mode description: Cloud; choosing it is the consent",
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostawca chmurowy wybrany za Twoją zgodą."
