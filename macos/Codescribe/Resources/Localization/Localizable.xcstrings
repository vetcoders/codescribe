    },
    "Text — during AI requests to the providers you configured." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekst — podczas zapytań AI do skonfigurowanych przez Ciebie dostawców."
          }
        }
      }
    },
    "The %@ pass returned no text" : {
      "comment" : "The placeholder is the name of the engine that ran the pass",
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przebieg „%@” nie zwrócił tekstu"
          }
        }
      }
    },
    "The Agent has not run yet — server status is checked on its first turn." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent nie został jeszcze uruchomiony — stan serwerów zostanie sprawdzony przy jego pierwszej turze."
          }
        }
      }
    },
    "The Agent looks for projects and Git repositories in these folders. It also searches subfolders, but skips hidden folders and build directories." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W tych folderach Agent szuka projektów i repozytoriów Git. Przeszukuje też podfoldery, ale pomija foldery ukryte i katalogi build."
          }
        }
      }
    },
    "The Codescribe skill folder for %@ will be moved to a retained backup beside it, then replaced with the copy bundled in this app. Your other skills and agent configuration are not changed. No listener will be started." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obecny skill Codescribe dla %@ zostanie zachowany jako kopia zapasowa, a następnie zastąpiony wersją dołączoną do tej aplikacji.\nPozostałe skille i ustawienia agenta pozostaną bez zmian. Instalacja nie uruchomi nasłuchiwania."
          }
        }
      }
    },
    "The LOCAL_MODEL environment variable overrides the selected model." : {
      "comment" : "Whisper model picker: an environment variable shadows the saved selection",
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LOCAL_MODEL ma pierwszeństwo przed modelem wybranym w aplikacji."
          }
        }
      }
    },
    "The app bundle does not contain the Codescribe agent bridge payload." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja Codescribe nie zawiera komponentu Agent Bridge."
          }
        }
      }
    },
    "The app you are pasting into may handle this shortcut as well." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja, do której wklejasz, może również obsłużyć ten skrót."
          }
        }
      }
    },
    "The assistive model isn't reachable yet — open Settings → Engine to configure the assistive lane." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model Agenta jest teraz niedostępny — otwórz Ustawienia › Silnik, aby skonfigurować Agenta"
          }
        }
      }
    },
    "The audio for this saved transcript is no longer available." : {
      "comment" : "Transcribe again is impossible: the archived take has no audio file",
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dźwięk tej zapisanej transkrypcji nie jest już dostępny."
          }
        }
      }
    },
    "The bundled agent bridge failed checksum verification: %@" : {
      "comment" : "The placeholder is a technical diagnostic produced by the installer",
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się zweryfikować integralności komponentu Agent Bridge: %@"
