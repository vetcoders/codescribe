    "Suggested rule for %@ from %lld variants. %llu occurrences." : {
      "comment" : "VoiceOver summary of a suggested dictionary rule. First placeholder is the word the rule corrects to; each count needs its own plural variation",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggested rule for %1$@ from %#@variants@. %#@occurrences@."
          },
          "substitutions" : {
            "occurrences" : {
              "argNum" : 3,
              "formatSpecifier" : "llu",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg occurrence"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg occurrences"
                    }
                  }
                }
              }
            },
            "variants" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
